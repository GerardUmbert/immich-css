{
  "checkedAgainst": "v3.3.5",
  "upstreamRoot": "web/src",
  "hooks": [
    {
      "id": "colors",
      "what": "No pure white / pure black surfaces; page background behind fixed bars",
      "why": "Pure #fff / #000 backgrounds are unwanted. Immich hard-codes them in a few places.",
      "css": "colors",
      "hooks": [
        "--immich-ui-light (full color, not a triplet)",
        "--immich-bg / --immich-dark-bg (RGB triplets)",
        "--color-white / --color-black (Tailwind theme vars)",
        "html.dark:root / html.light:root"
      ],
      "upstream": [
        "app.css",
        "app.html"
      ],
      "external": [],
      "verified": "source + runtime (pure-black strip on search page traced to app.html)",
      "fragile": false,
      "ui": [
        "theme/default.css"
      ],
      "anchors": [
        {
          "file": "app.html",
          "match": "html\\.dark\\s*\\{\\s*background-color:\\s*black",
          "means": "html.dark hard-codes a black background"
        },
        {
          "file": "app.html",
          "match": "html\\.light\\s*\\{\\s*background-color:\\s*white",
          "means": "html.light hard-codes a white background"
        },
        {
          "file": "app.css",
          "match": "--immich-dark-bg:",
          "means": "legacy dark background variable"
        },
        {
          "file": "theme/default.css",
          "match": "--immich-ui-light:",
          "means": "ui theme still defines --immich-ui-light",
          "scope": "ui"
        }
      ]
    },
    {
      "id": "accent",
      "what": "Optional accent color switch (off by default)",
      "why": "Lets the purple / pale blue accent be changed from one value.",
      "css": "accent color",
      "hooks": [
        "--immich-primary",
        "--immich-dark-primary",
        "--immich-ui-primary-50..950"
      ],
      "upstream": [
        "app.css"
      ],
      "external": [],
      "verified": "source only (shown once in a running instance, then reverted)",
      "fragile": false,
      "ui": [
        "theme/default.css"
      ],
      "anchors": [
        {
          "file": "app.css",
          "match": "--immich-primary:",
          "means": "legacy light accent variable"
        },
        {
          "file": "app.css",
          "match": "--immich-dark-primary:",
          "means": "legacy dark accent variable"
        },
        {
          "file": "theme/default.css",
          "match": "--immich-ui-primary-500:",
          "means": "ui accent scale base",
          "scope": "ui"
        }
      ]
    },
    {
      "id": "photo-grid",
      "what": "Rounded day groups and photos, hover zoom (timeline, search, albums, galleries)",
      "why": "Softer look; photos zoom slightly on hover.",
      "css": "timeline",
      "hooks": [
        "[data-image-grid]",
        "[data-asset-id]",
        ":has(> [data-thumbnail-focus-container])",
        ":is(img, video) inside the slot (video thumbnails swap img for <video> on hover)"
      ],
      "upstream": [
        "lib/components/timeline/AssetLayout.svelte",
        "lib/components/assets/thumbnail/Thumbnail.svelte",
        "lib/components/shared-components/gallery-viewer/GalleryViewer.svelte",
        "lib/components/assets/thumbnail/VideoThumbnail.svelte"
      ],
      "external": [],
      "verified": "source + runtime (pasted timeline markup)",
      "fragile": false,
      "ui": [],
      "anchors": [
        {
          "file": "lib/components/timeline/AssetLayout.svelte",
          "match": "data-image-grid",
          "means": "day group container hook"
        },
        {
          "file": "lib/components/timeline/AssetLayout.svelte",
          "match": "data-asset-id",
          "means": "photo slot hook"
        },
        {
          "file": "lib/components/assets/thumbnail/Thumbnail.svelte",
          "match": "data-thumbnail-focus-container",
          "means": "thumbnail root hook (search and album grids)"
        },
        {
          "file": "lib/components/assets/thumbnail/VideoThumbnail.svelte",
          "match": "<video",
          "means": "video thumbnails still use a <video> element that replaces the still image on hover (it must zoom like the img)"
        }
      ]
    },
    {
      "id": "navbar-search",
      "what": "Search box centered in the top navbar",
      "why": "The search wrapper (max-w-5xl, flex-1) was pushed against the logo side.",
      "css": "timeline (Top navbar)",
      "hooks": [
        "#dashboard-navbar div:has(> div > form[role='search'])"
      ],
      "upstream": [
        "lib/components/shared-components/navigation-bar/NavigationBar.svelte",
        "lib/components/shared-components/search-bar/SearchBar.svelte"
      ],
      "ui": [],
      "external": [],
      "verified": "source only",
      "fragile": false,
      "anchors": [
        {
          "file": "lib/components/shared-components/navigation-bar/NavigationBar.svelte",
          "match": "id=\"dashboard-navbar\"",
          "means": "navbar id"
        },
        {
          "file": "lib/components/shared-components/navigation-bar/NavigationBar.svelte",
          "match": "<div[^>]*>\\s*\\{#if featureFlagsManager\\.value\\.search\\}\\s*<SearchBar",
          "means": "search wrapper div directly contains SearchBar"
        },
        {
          "file": "lib/components/shared-components/search-bar/SearchBar.svelte",
          "match": "<div[^>]*>\\s*<form[\\s\\S]*?role=\"search\"",
          "means": "SearchBar renders div > form[role=search]"
        }
      ]
    },
    {
      "id": "selection-bar",
      "what": "Frosted-glass selection / control bar",
      "why": "Replace the solid gray pill.",
      "css": "timeline (Selection / control bar)",
      "hooks": [
        "#control-bar > nav"
      ],
      "upstream": [
        "lib/components/shared-components/ControlAppBar.svelte"
      ],
      "external": [],
      "verified": "source only",
      "fragile": false,
      "ui": [
        "components/ControlBar/ControlBar.svelte"
      ],
      "anchors": [
        {
          "file": "lib/components/shared-components/ControlAppBar.svelte",
          "match": "id=\"control-bar\"",
          "means": "control bar wrapper id"
        },
        {
          "file": "components/ControlBar/ControlBar.svelte",
          "match": "<nav",
          "means": "ControlBar renders a <nav>",
          "scope": "ui"
        }
      ]
    },
    {
      "id": "scroll-behind-bar",
      "what": "Photos scroll up behind the top bar instead of being cut off",
      "why": "Top padding sat outside the scroller and clipped content.",
      "css": "timeline (Timeline scroll area, Album / person / partner / shared pages)",
      "hooks": [
        "div:has(> #asset-grid)",
        "#asset-grid",
        "main:has(> #asset-grid)",
        "main > #asset-grid",
        "body:has(#asset-grid) #control-bar (keeps the bar clear of the scrubber strip)"
      ],
      "upstream": [
        "lib/components/timeline/Timeline.svelte",
        "lib/components/layouts/UserPageLayout.svelte",
        "lib/components/album-page/AlbumViewer.svelte",
        "routes/(user)/albums/[albumId=id]/[[photos=photos]]/[[assetId=id]]/+page.svelte",
        "routes/(user)/partners/[userId]/[[photos=photos]]/[[assetId=id]]/+page.svelte",
        "routes/(user)/people/[personId]/[[photos=photos]]/[[assetId=id]]/+page.svelte",
        "lib/components/timeline/Scrubber.svelte",
        "lib/components/shared-components/ControlAppBar.svelte"
      ],
      "external": [],
      "verified": "source + runtime (main page and album screenshots)",
      "fragile": false,
      "ui": [],
      "anchors": [
        {
          "file": "lib/components/timeline/Timeline.svelte",
          "match": "id=\"asset-grid\"",
          "means": "timeline scroller id"
        },
        {
          "file": "lib/components/timeline/Scrubber.svelte",
          "match": "DESKTOP_WIDTH\\s*=\\s*60\\b",
          "means": "scrubber width is 60px (hard-coded as --c-scrubber-w in the CSS)"
        },
        {
          "file": "lib/components/timeline/Scrubber.svelte",
          "match": "data-id=\"scrubber\"",
          "means": "scrubber hook"
        }
      ]
    },
    {
      "id": "timeline-skeleton",
      "what": "Loading placeholder of the timeline looks like a justified gallery (mixed widths, rounded cells)",
      "why": "Immich tiles one flat square image over a whole unloaded month; this mimics real rows instead, colored from the accent scale.",
      "css": "Timeline loading placeholder",
      "hooks": [
        "#virtual-timeline [data-skeleton]"
      ],
      "upstream": [
        "lib/elements/Skeleton.svelte",
        "lib/components/timeline/Timeline.svelte"
      ],
      "ui": [],
      "external": [],
      "verified": "rendered in headless Chrome (light, dark, mobile width); not yet seen in a running Immich",
      "fragile": false,
      "anchors": [
        {
          "file": "lib/elements/Skeleton.svelte",
          "match": "data-skeleton=\"true\"",
          "means": "skeleton element hook"
        },
        {
          "file": "lib/elements/Skeleton.svelte",
          "match": "background-image:\\s*url\\(",
          "means": "skeleton draws its pattern with a background-image (replaced by the mask)"
        },
        {
          "file": "lib/components/timeline/Timeline.svelte",
          "match": "id=\"virtual-timeline\"[\\s\\S]*<Skeleton",
          "means": "skeleton is rendered inside #virtual-timeline"
        },
        {
          "file": "lib/components/timeline/Timeline.svelte",
          "match": "rowHeight:\\s*235",
          "means": "desktop row height is 235 (hard-coded in the mask)"
        },
        {
          "file": "lib/components/timeline/Timeline.svelte",
          "match": "rowHeight:\\s*100",
          "means": "mobile row height is 100 (hard-coded in the mask)"
        },
        {
          "file": "lib/elements/Skeleton.svelte",
          "match": "max-width:\\s*767px",
          "means": "skeleton switches size at 767px (the mask media query matches it)"
        }
      ]
    },
    {
      "id": "account-menu",
      "what": "Solid off-white account panel, pill-shaped Sign Out",
      "why": "Remove the gray box, white cards and hard 4px gap. Immich's focusTrap action inserts sentinel <div>s as first and last children, so child-position selectors (:first-child / :last-child) hit those instead of the real content.",
      "css": "Account menu",
      "hooks": [
        "#account-info-panel",
        "#account-info-panel > div:has(figure)",
        "#account-info-panel > div > a[href$='/auth/logout']"
      ],
      "upstream": [
        "lib/components/shared-components/navigation-bar/AccountInfoPanel.svelte",
        "lib/actions/focus-trap.ts"
      ],
      "external": [],
      "verified": "source + runtime (outerHTML pasted from a v3.3.1 server)",
      "fragile": false,
      "ui": [
        "internal/Button.svelte",
        "components/IconButton/IconButton.svelte"
      ],
      "anchors": [
        {
          "file": "lib/components/shared-components/navigation-bar/AccountInfoPanel.svelte",
          "match": "id=\"account-info-panel\"",
          "means": "panel id"
        },
        {
          "file": "lib/components/shared-components/navigation-bar/AccountInfoPanel.svelte",
          "match": "Route\\.logout\\(\\)",
          "means": "sign-out link comes from Route.logout()"
        },
        {
          "file": "lib/route.ts",
          "match": "logout:[^\\n]*'/auth/logout'",
          "means": "logout path (selector matches an href ending in /auth/logout)"
        },
        {
          "file": "lib/actions/focus-trap.ts",
          "match": "dataset\\.focusTrap",
          "means": "focus trap still inserts sentinel divs (why child-position selectors are avoided)"
        },
        {
          "file": "lib/components/shared-components/UserAvatar.svelte",
          "match": "<figure",
          "means": "avatar renders a <figure> (the profile card is found by it)"
        }
      ]
    },
    {
      "id": "search-buttons",
      "what": "Softer borders on search filter buttons",
      "why": "@immich/ui outline buttons draw the border in the exact text color.",
      "css": "Search filter panel",
      "hooks": [
        "[role='listbox'] button[class*='border-dark']"
      ],
      "upstream": [
        "lib/components/shared-components/search-bar/SearchFilters.svelte",
        "lib/components/shared-components/search-bar/SearchButton.svelte"
      ],
      "external": [],
      "verified": "source only",
      "fragile": true,
      "ui": [
        "internal/Button.svelte"
      ],
      "anchors": [
        {
          "file": "lib/components/shared-components/search-bar/SearchFilters.svelte",
          "match": "role=\"listbox\"",
          "means": "search dropdown keeps role=listbox"
        },
        {
          "file": "internal/Button.svelte",
          "match": "border-dark",
          "means": "ui secondary outline button still uses the border-dark class",
          "scope": "ui"
        }
      ]
    },
    {
      "id": "people",
      "what": "Circle people cards (grow + ring), plain-text names, glass menu button, fixed-size grid",
      "why": "Cleaner people page; same grow effect as explore avatars.",
      "css": "people",
      "hooks": [
        "#people-card",
        "div:has(> #people-card)",
